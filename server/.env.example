# Copy to .env and fill in. Never commit .env.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ProjectEval?retryWrites=true&w=majority

# Long random string (64+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_ORIGIN=http://localhost:5173

# Number of proxies in front of the API (0/false locally, 1 on Render, 2 behind the Vercel rewrite)
TRUST_PROXY=false

# lax (recommended, same-site via Vercel rewrite) or none (frontend and API on different sites)
COOKIE_SAMESITE=lax

# Time zone used for the default attendance session date
EVENT_TIMEZONE=Asia/Kolkata

# Super Admin — read only by `npm run seed:admin` (required; there is no default).
# Password: 8-128 characters with at least one letter and one number. Use a unique, strong value.
# The password is stored hashed; you may delete ADMIN_PASSWORD from .env after seeding.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@your-college.edu
ADMIN_PASSWORD=change-me-to-a-strong-unique-password
