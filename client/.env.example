# Leave unset to call the API at /api (Vite proxy locally, Vercel rewrite in production).
# Only set this if the API is served from a different site; then also set COOKIE_SAMESITE=none on the server.
# VITE_API_URL=https://your-api.onrender.com/api

# Local development only: where the Vite dev proxy forwards /api (default http://localhost:5000)
# VITE_PROXY_TARGET=http://localhost:5000
